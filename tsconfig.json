{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "strict": true,
    "noEmitOnError": true,
    "removeComments": true,
    "rootDir": "static/ts",
    "outDir": "static/js",
    "skipLibCheck": false,
    "declaration": true,
    "declarationDir": "artifacts/types"
  },
  "include": [
    "static/ts/**/*.ts"
  ]
}
