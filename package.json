{
  "name": "comet",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "build:tests": "tsc -p tsconfig.declarations.json && node scripts/build-test-runtime.mjs && tsc -p tsconfig.tests.json",
    "test:frontend": "npm run build && npm run build:tests && node --test artifacts/tests/*.test.cjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "lightweight-charts": "5.0.9",
    "playwright": "1.55.1",
    "typescript": "5.9.3",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.6"
  },
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "next": "^16.4.0"
  }
}
