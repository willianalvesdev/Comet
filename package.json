{
  "name": "ascenda",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.tests.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:tests": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.tests.json",
    "test:frontend": "npm run build && npm run build:tests && node --test artifacts/tests/*.test.cjs",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.18.6",
    "playwright": "1.55.1",
    "lightweight-charts": "5.0.9"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
