{
  "name": "comet",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "build:tests": "tsc -p tsconfig.declarations.json && node scripts/build-test-runtime.mjs && tsc -p tsconfig.tests.json",
    "test:frontend": "npm run build && npm run build:tests && node --test artifacts/tests/*.test.cjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "predev": "node scripts/sync-static.mjs",
    "prebuild": "node scripts/sync-static.mjs",
    "start": "next start --hostname 127.0.0.1 --port 5001",
    "db:setup": "node --env-file=.env --import tsx scripts/setup-db.ts",
    "test:server": "node --env-file=.env --import tsx --test tests/server/*.test.ts",
    "news:setup": "node scripts/configurar-noticias.mjs",
    "test:production": "npm run build && node --env-file=.env --import tsx --test tests/production/*.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/validator": "^13.15.10",
    "esbuild": "^0.28.2",
    "playwright": "1.55.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "entities": "^8.1.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.12",
    "next": "16.4.3",
    "nodemailer": "^10.1.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "validator": "^13.15.35"
  }
}
