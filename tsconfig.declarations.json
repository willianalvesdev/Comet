{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "frontend",
    "outDir": "artifacts/types",
    "jsx": "react-jsx"
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.tsx"
  ],
  "exclude": [
    "frontend/NextApplication.tsx"
  ]
}
